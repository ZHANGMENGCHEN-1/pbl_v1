[Unit]
Description=PBL Backend
After=network-online.target
Wants=network-online.target

[Service]
User=ecs-user
WorkingDirectory=/home/ecs-user/apps/pbl_v1/backend
ExecStart=/home/ecs-user/apps/pbl_v1/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=multi-user.target
